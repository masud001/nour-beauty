    $(document).ready(function() {
        // Track processed notifications
        const processedNotifications = new Set();

        // Select the node that will be observed for mutations
        const targetNode = document.body;

        // Options for the observer (which mutations to observe)
        const config = {
            childList: true,
            subtree: true
        };

        // Callback function to execute when mutations are observed
        const callback = function(mutationsList, observer) {
            mutationsList.forEach(mutation => {
                // Check added nodes for notifications after a short delay
                // setTimeout(() => {
                $(mutation.addedNodes).each(function() {
                    let $addedNode = $(this);

                    // Check if the added node or its children contain the notification class
                    if ($addedNode.hasClass('notification') || $addedNode.find('.notification').length > 0) {
                        console.log('innnnnnnn 2');

                        // Handle the notification nodes
                        $addedNode.find('.notification').addBack('.notification').each(function() {
                            let $notification = $(this);
                            let notificationText = $notification.text().trim();
                            console.log($notification, ' $notification');
                            console.log(notificationText, ' notificationText');

                            // Remove old notifications
                            $('.notification').not($notification).remove();

                            // Check if this notification should be displayed
                            if ((notificationText.startsWith('Saved to your wish list') || notificationText.startsWith('Removed to your Wish list'))) {
                                // Mark this notification as processed
                                processedNotifications.add(notificationText);

                                // Remove any existing image within the notification
                                // $notification.find('img').remove();

                                // Define image source
                                let imageSrc = 'https://www.nour-beauty.com/assets/website/imgs/heart-icn.svg';

                                // Create new image element
                                let $image = $('<img>').attr('src', imageSrc);

                                // Append new image to the notification
                                $notification.append($image);

                                // Remove the notification after 3 seconds
                                setTimeout(function() {
                                    $notification.remove();
                                }, 300000);
                            }
                        });
                    }
                });
                // }, 10); // 250 milliseconds delay (0.25 seconds)
            });
        };

        // Create an observer instance linked to the callback function
        const observer = new MutationObserver(callback);

        // Start observing the target node for configured mutations
        observer.observe(targetNode, config);
    });
