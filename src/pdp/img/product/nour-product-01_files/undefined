    $(document).ready(function() {
        $('.cwp-btn').click(function() {
            $('.enter-phone-sect').show();
            $('.login-sect').hide();
        });
        $('.back-btn-2').click(function() {
            $('.enter-phone-sect').show();
            $('.enter-phone-sect2').hide();
        });
        $('.back-btn-1').click(function() {
            $('.login-sect').show();
            $('.enter-phone-sect').hide();
        });
    });

    const inputs = document.querySelectorAll('.opt-input');
    for (let i = 0; i < inputs.length; i++) {
        inputs[i].addEventListener('keydown', function(event) {
            $('.cust-nxt-btn2').css("background", "#FFFFFF");
            $('.cust-nxt-btn2').css("color", "#AD1F1A");
            if (event.key === "Backspace") {
                if (inputs[i].value == '') {
                    if (i != 0) {
                        event.preventDefault();
                        inputs[i - 1].focus();
                        event.preventDefault();
                    }
                } else {
                    inputs[i].value = '';
                }

            } else if (event.key == "Enter" && i == 3) {
                submit_form();
            } else if (event.key === "Enter") {
                event.preventDefault();

            } else if (event.key === "ArrowLeft" && i !== 0) {
                inputs[i - 1].focus();
            } else if (event.key === "ArrowRight" && i !== inputs.length - 1) {
                inputs[i + 1].focus();
            } else if (event.key != "ArrowLeft" && event.key != "ArrowRight") {
                inputs[i].setAttribute("type", "text");
                inputs[i].value = ''; // Bug Fix: allow user to change a random otp digit after pressing it
            }
        });
        inputs[i].addEventListener('input', function() {
            inputs[i].value = inputs[i].value
                .toUpperCase(); // Converts to Upper case. Remove .toUpperCase() if conversion isnt required.
            if (i === inputs.length - 1 && inputs[i].value !== '') {
                console.log(i)
                inputs[i].closest('form');
                return true;
            } else if (inputs[i].value !== '') {
                inputs[i + 1].focus();
            }
        });
    }

    window.addEventListener('keydown', function(e) {
        if (e.keyIdentifier == 'U+000A' || e.keyIdentifier == 'Enter' || e.keyCode == 13) {
            if (e.target.nodeName == 'INPUT' && e.target.type == 'text') {
                e.preventDefault();
                return false;
            }
        }
    }, true);


    $('.resend-otp-button').click(function() {
        $('#resend-otp').hide();
        var get_resend_flag = document.getElementById('resend-otp-countdown').innerHTML;
        if (get_resend_flag == ' ') {
            $.ajax({
                url: "https://www.nour-beauty.com/website/login/send_otp",
                method: "post",
                data: {
                    'mob_no': $('#mob-no').val(),
                    'country_code': $('#country_code').val(),
                },
                dataType: "json",
                success: function(data) {
                    console.log(data);
                    if (data.code == '1') {
                        var number = $('#country_code').val() + ' ' + $('#mob-no').val();
                        $('#display_mobile_number').text(number);
                        $('.enter-phone-sect2').show();
                        $('.enter-phone-sect').hide();
                        var remainingTime = 60;

                        // Start the countdown
                        var countdown = setInterval(function() {
                            if (remainingTime > 0) {
                                var computeMinutes = Math.floor(remainingTime / 60);
                                var result = remainingTime % 60;
                                if (result < 10) {
                                    $('.countdown').text('00:0' + result);
                                } else {
                                    $('.countdown').text('00:' + result);
                                }
                                remainingTime--;
                            } else {
                                clearInterval(countdown);
                                $('#resend-otp').prop('disabled', false);
                            }
                            if (remainingTime == '0') {
                                $('.countdown').html(' ');
                                $('#resend-otp').show();
                            } else {
                                $('#resend-otp').hide();
                            }
                        }, 1000);
                    } else {
                        $('.enter-phone-sect').show();
                        $('.enter-phone-sect2').hide();
                    }
                },
                error: function(e) {
                    //error
                }
            });
        }
    });

    function submit_form() {
        var websiteSegment = "undefined";
        if ($('#otp-1').val() != '' && $('#otp-2').val() != '' && $('#otp-3').val() != '' && $('#otp-4').val() != '') {
            $.ajax({
                url: "https://www.nour-beauty.com/website/login/signup_mobile",
                method: "post",
                data: {
                    'mob_no': $('#mob-no').val(),
                    'country_code': $('#country_code').val(),
                    'otp': [$('#otp-1').val(), $('#otp-2').val(), $('#otp-3').val(), $('#otp-4').val()]
                },
                dataType: "json",
                success: function(data) {
                    console.log(data);
                    if (data.code == '1') {
                        // console.log("klaviyo login event",JSON.stringify(data));
                        function myCallback() {
                        // console.log("klaviyo login event",JSON.stringify(data));

                            var item = {
                                "user_id": data.data?.id.toString() || '',
                                "name": data.data?.full_name || '',
                                "device_type": "Website",
                                "day": 'Friday',
                                "current_time": '2025-03-07T09:17:56+00:00'
                            };
                            // console.log("klaviyo login event", item);

                            klaviyo.track("login_user", item);
                            // klaviyo.push(["track", "login_user", item]);

                            }

                            klaviyo.identify({
                            'email': data.data?.email || '',
                            '$first_name': data.data?.full_name || '',
                            'phone_number': (data.data?.country_code || '') +' '+ (data.data?.mobile_number || ''),
                            'external_id': data.data?.id.toString() || ''
                            },function(){ 
                                myCallback();
                                if (websiteSegment == 'cart') {
                                    window.location.href = "https://www.nour-beauty.com/cart";
                                }
                                else if (websiteSegment == 'summary') {
                                    window.location.href = "https://www.nour-beauty.com/cart/summary";
                                }
                                else {
                                    window.location.href = "https://www.nour-beauty.com/home";
                                }});
                        
                        
                } else {
                        var errorMessage = document.getElementById("otp-error-message");
                        errorMessage.textContent = data.message;
                    }
                },
                error: function(e) {
                    //error
                }
            });

        } else {
            var errorMessage = document.getElementById("otp-error-message");
            errorMessage.textContent = "Please enter valid OTP";
        }
    }




    document.getElementById('googleSignInButton').addEventListener('click', function () {
    // Fetch the Google Auth URL via AJAX
    fetch("https://www.nour-beauty.com/website/login/get_google_auth_url") // Update with your controller's URL
        .then(response => response.json())
        .then(data => {
            if (data.auth_url) {
                // Redirect to the Google Auth URL
                window.location.href = data.auth_url;
            } else {
                alert('Failed to fetch Google Sign-In URL.');
            }
        })
        .catch(error => console.error('Error fetching Google Auth URL:', error));
});
