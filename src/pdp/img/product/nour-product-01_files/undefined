    function searchBrands() {
        var input, filter, brands, divs, labels, i, txtValue;
        input = document.getElementById('search_brand_filter');
        filter = input.value.toUpperCase();
        brands = document.querySelectorAll('.accordion-body .row .col-md-6.mb-4');
        for (i = 0; i < brands.length; i++) {
            labels = brands[i].getElementsByTagName("label");
            for (var j = 0; j < labels.length; j++) {
                txtValue = labels[j].textContent || labels[j].innerText;
                if (txtValue.toUpperCase().startsWith(filter)) {
                    brands[i].style.display = "";
                    break; // If one label matches, show the whole div and move to the next one
                } else {
                    brands[i].style.display = "none";
                }
            }
        }
    }

