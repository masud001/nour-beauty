{
  "name": "nour-beauty",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "scss:build": "sass src/assets/scss/style.scss src/assets/css/style.css --style=expanded --no-source-map",
    "scss:watch": "sass src/assets/scss:src/assets/css --watch --style=expanded --no-source-map",
    "scss:minify": "sass src/assets/scss/style.scss src/assets/css/style.min.css --style=compressed --no-source-map",
    "watch": "concurrently \"npm run scss:watch\" \"npm run dev\"",
    "start": "npm run watch"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sass": "^1.83.4",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3"
  }
}